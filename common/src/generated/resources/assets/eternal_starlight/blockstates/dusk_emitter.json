        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "eternal_starlight:block/dusk_emitter",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "eternal_starlight:block/dusk_emitter",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "eternal_starlight:block/dusk_emitter",
        "uvlock": true,
        "x": 270,
        "y": 180
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "eternal_starlight:block/dusk_emitter",
