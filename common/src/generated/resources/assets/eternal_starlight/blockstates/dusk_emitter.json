      }
    },
    {
      "apply": {
        "model": "eternal_starlight:block/dusk_emitter_off",
        "y": 270
      },
      "when": {
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "eternal_starlight:block/dusk_emitter_off",
        "x": 270,
        "y": 180
      },
      "when": {
        "up": "false"
      }
    },
    {
      "apply": {
        "model": "eternal_starlight:block/dusk_emitter_off",
